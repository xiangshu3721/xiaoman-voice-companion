      "defense",
      "responsibility_shift",
      "counterattack"
    ]
  },
  {
    "id": "Withdrawer",
    "name": "回避型",
    "description": "不想继续冲突，减少回应、转移话题、离开或沉默。",
    "tendencies": [
      "withdrawal",
      "topic_shift",
      "silent_treatment"
    ]
  },
  {
    "id": "Rationalizer",
    "name": "说理型",
    "description": "强调事实、逻辑和规则，容易忽视对方的感受。",
    "tendencies": [
      "defense",
      "dismissal",
      "topic_shift"
    ]
  },
  {
    "id": "Pleaser",
    "name": "讨好型",
    "description": "害怕关系破裂，容易快速道歉、妥协，但不一定真的理解问题。",
    "tendencies": [
      "perfunctory_apology",
      "genuine_apology",
      "repair_attempt"
    ]
  },
  {
    "id": "PassiveAggressive",
    "name": "阴阳型",
    "description": "很少直接攻击，大量使用反话、讽刺、冷笑和短句。",

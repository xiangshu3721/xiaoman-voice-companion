      "sarcasm",
      "mockery",
      "perfunctory_response"
    ]
  },
  {
    "id": "Explosive",
    "name": "爆发型",
    "description": "平时压抑，达到阈值后迅速升级，语言强度突然增加。",
    "tendencies": [
      "counterattack",

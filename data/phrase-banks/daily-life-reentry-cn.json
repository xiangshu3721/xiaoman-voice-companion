    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-167",
    "category": "CARE_BEHAVIOR",
    "text": "你声音都哑了，少说点。",
    "tags": [
      "daily_life_reentry",
      "care_behavior"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-168",
    "category": "CARE_BEHAVIOR",
    "text": "先把气顺了。",
    "tags": [
      "daily_life_reentry",
      "care_behavior"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-169",
    "category": "CARE_BEHAVIOR",
    "text": "你去躺一会儿吧。",
    "tags": [
      "daily_life_reentry",
      "care_behavior"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-170",
    "category": "CARE_BEHAVIOR",
    "text": "外面冷，回来把手捂热。",
    "tags": [
      "daily_life_reentry",
      "care_behavior"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-171",
    "category": "CARE_BEHAVIOR",
    "text": "你先歇着，我来弄。",
    "tags": [
      "daily_life_reentry",
      "care_behavior"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-172",
    "category": "CARE_BEHAVIOR",
    "text": "别饿着自己。",
    "tags": [
      "daily_life_reentry",
      "care_behavior"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-173",
    "category": "CARE_BEHAVIOR",
    "text": "喝口水，别光顾着嘴硬。",
    "tags": [
      "daily_life_reentry",
      "care_behavior"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-174",
    "category": "CARE_BEHAVIOR",
    "text": "你先把情绪放一放。",
    "tags": [
      "daily_life_reentry",
      "care_behavior"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-175",
    "category": "CARE_BEHAVIOR",
    "text": "今天就别折腾了。",
    "tags": [
      "daily_life_reentry",
      "care_behavior"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-176",
    "category": "CARE_BEHAVIOR",
    "text": "过来，我给你倒水。",
    "tags": [
      "daily_life_reentry",
      "care_behavior"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-177",
    "category": "CARE_BEHAVIOR",
    "text": "你眼睛都困了，早点休息。",
    "tags": [
      "daily_life_reentry",
      "care_behavior"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-178",
    "category": "CARE_BEHAVIOR",
    "text": "先把饭吃了，别空着肚子吵。",
    "tags": [
      "daily_life_reentry",
      "care_behavior"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-179",
    "category": "CARE_BEHAVIOR",
    "text": "你去换件舒服的衣服。",
    "tags": [
      "daily_life_reentry",
      "care_behavior"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-180",
    "category": "CARE_BEHAVIOR",
    "text": "没事，先让自己缓下来。",
    "tags": [
      "daily_life_reentry",
      "care_behavior"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-181",
    "category": "HUMOROUS_BARGAIN",
    "text": "想让我原谅你？奶茶一杯。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-182",
    "category": "HUMOROUS_BARGAIN",
    "text": "你请我吃饭，我就考虑考虑。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-183",
    "category": "HUMOROUS_BARGAIN",
    "text": "给我买个冰淇淋，这事先翻一页。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-184",
    "category": "HUMOROUS_BARGAIN",
    "text": "你把垃圾扔了，我就不跟你计较。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-185",
    "category": "HUMOROUS_BARGAIN",
    "text": "笑一个，不然不算和好。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-186",
    "category": "HUMOROUS_BARGAIN",
    "text": "你先把水递过来，和好仪式开始。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-187",
    "category": "HUMOROUS_BARGAIN",
    "text": "请我看电影，我就给你加分。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-188",
    "category": "HUMOROUS_BARGAIN",
    "text": "你负责洗碗，我负责暂时消气。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-189",
    "category": "HUMOROUS_BARGAIN",
    "text": "行，拿一杯热饮换我不板脸。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-190",
    "category": "HUMOROUS_BARGAIN",
    "text": "你把我逗笑，这事就先放着。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-191",
    "category": "HUMOROUS_BARGAIN",
    "text": "给我一块蛋糕，剩下的以后再审。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-192",
    "category": "HUMOROUS_BARGAIN",
    "text": "你先把灯关了，表现分加一分。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-193",
    "category": "HUMOROUS_BARGAIN",
    "text": "陪我散步一圈，算你诚意到了。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-194",
    "category": "HUMOROUS_BARGAIN",
    "text": "今天的和好条件是：不许再顶嘴。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-195",
    "category": "HUMOROUS_BARGAIN",
    "text": "你给我挑个电影，我就不追问了。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-196",
    "category": "HUMOROUS_BARGAIN",
    "text": "先把水果端来，我听听你的解释。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-197",
    "category": "HUMOROUS_BARGAIN",
    "text": "你表现好一点，我就少念叨两句。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-198",
    "category": "HUMOROUS_BARGAIN",
    "text": "给我捏两分钟肩，暂时放过你。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-199",
    "category": "HUMOROUS_BARGAIN",
    "text": "行，先交一份拥抱，我再决定。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  },
  {
    "id": "reentry-200",
    "category": "HUMOROUS_BARGAIN",
    "text": "你把晚饭安排好，今天就算你过关。",
    "tags": [
      "daily_life_reentry",
      "humorous_bargain"
    ],
    "sourceType": "synthetic_seed"
  }
]

# DeepSeek API key. Leave blank to use the local mock reply mode.
DEEPSEEK_API_KEY=

# Volcengine / Doubao Seed-TTS 2.0. These variables are server-only.
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_MODEL=seed-tts-2.0-standard
VOLCENGINE_TTS_VOICE=zh_female_vv_uranus_bigtts
VOLCENGINE_TTS_VOICE_NAME=vivi 2.0（官方预置·通用场景女声）
DEFAULT_FEMALE_SPEAKER=zh_female_vv_uranus_bigtts
DEFAULT_MALE_SPEAKER=zh_male_dayi_saturn_bigtts
# Optional JSON array to override the candidate list shown in /voice-lab.
# If omitted, the app shows several official female and male candidates.
# VOLCENGINE_TTS_VOICES_JSON=[{"id":"zh_female_vv_uranus_bigtts","name":"小满候选女声","gender":"female","description":"自然聊天候选"},{"id":"zh_male_dayi_saturn_bigtts","name":"大壹","gender":"male","description":"男性角色候选"}]

# Volcengine / Doubao ASR. Server-only; never expose these as NEXT_PUBLIC_*.
# Mobile browsers upload a short WAV/OGG/M4A turn to /api/asr.
VOLCENGINE_ASR_API_KEY=
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration

# GitHub Pages frontend only. These values are public and must not contain secrets.
# NEXT_PUBLIC_API_BASE_URL=https://your-env-id.region.app.tcloudbase.com/xiaoman-api
# NEXT_PUBLIC_BASE_PATH=/repository-name

# Tencent Cloud backend only. Set this in CloudBase, not in the Pages build.
# CORS_ORIGIN=https://your-github-name.github.io
